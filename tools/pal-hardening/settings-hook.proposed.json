{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__clink",
        "hooks": [
          {
            "type": "command",
            "command": "node \"<PROJET>/tools/pal-hardening/guard-clink.mjs\"",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
